(version 1)
(rule "Dense power IC pin escapes"
 (condition "A.memberOfFootprint('U3') || B.memberOfFootprint('U3') || A.memberOfFootprint('U4') || B.memberOfFootprint('U4') || A.memberOfFootprint('U8') || B.memberOfFootprint('U8') || A.memberOfFootprint('U6') || B.memberOfFootprint('U6') || A.memberOfFootprint('U7') || B.memberOfFootprint('U7')")
 (constraint clearance (min 0.12mm)))
(rule "JLC component PTH hole to copper"
 (condition "A.Pad_Type == 'Through-hole' || B.Pad_Type == 'Through-hole'")
 (constraint hole_clearance (min 0.28mm)))
(rule "Mechanical nonplated hole margin"
 (condition "A.Pad_Type == 'NPTH, mechanical' || B.Pad_Type == 'NPTH, mechanical'")
 (constraint hole_clearance (min 0.25mm)))

(rule "JLC SMT land-to-land minimum"
 (condition "A.Type == 'Pad' && B.Type == 'Pad' && A.Pad_Type == 'SMD' && B.Pad_Type == 'SMD'")
 (constraint clearance (min 0.15mm)))
