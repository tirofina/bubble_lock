# Candidate contract 0.1.0. Replace all REPLACE_* / *.example.invalid values.
# This file contains no usable credentials and is not a working deployment.
GATEWAY_ID=REPLACE_GATEWAY_ID
M2M_ORIGINATOR=C_REPLACE_AE_ID
M2M_CSE_ID=REPLACE_CSE_ID

# HTTPS origin only. Put the complete CSE resource path in each container.
M2M_CSE_URL=https://mobius.example.invalid:8443
M2M_OBSERVATION_CONTAINER=/Mobius/REPLACE_GATEWAY_AE/observations
M2M_RECEIPT_CONTAINER=/Mobius/REPLACE_GATEWAY_AE/receipts
M2M_HEALTH_CONTAINER=/Mobius/REPLACE_GATEWAY_AE/health
# Example only: PC-MOBIUS must confirm the supported RVI using its capability probe.
M2M_RVI=3

# HTTPS base URL; code appends /api/v1/gateways/{GATEWAY_ID}.
# A deployment prefix is allowed, but do not include /api/v1 here.
PC_API_URL=https://pc-api.example.invalid
TLS_CA_FILE=/etc/privacy-bubble/tls/ca.pem
TLS_CERT_FILE=/etc/privacy-bubble/tls/client.pem
TLS_KEY_FILE=/etc/privacy-bubble/tls/client.key

# MQTT 3.1.1 over TLS 1.3+. Set false to use HTTPS delivery only.
MQTT_ENABLED=true
# Set true only when the PC-MOBIUS capability probe requires an m2m:rqp wrapper.
# Default is the flat oneM2M primitive; the daemon does not retry alternate formats.
MQTT_WRAPPED_PRIMITIVE=false
MQTT_HOST=mqtt.example.invalid
MQTT_PORT=8883
MQTT_KEEPALIVE=60
REQUEST_TIMEOUT=10

# Placeholder address; replace with the paired keyring address and its exact deviceId.
BLE_DEVICES='{"REPLACE_DEVICE_ID":"00:00:00:00:00:00"}'
# Required by this implementation. Pair each device with its own configured passkey.
BLE_PAIR=true
BLE_SCAN_SECONDS=5
BLE_COMMAND_TIMEOUT=15
# Optional comma-separated exact revisions; empty means no extra revision restriction.
FIRMWARE_REVISION_ALLOWLIST=

GATEWAY_DATABASE=/var/lib/privacy-bubble-gateway/gateway.sqlite3
POLL_INTERVAL=2
HEARTBEAT_INTERVAL=30
CREDENTIAL_CHECK_INTERVAL=15
CREDENTIAL_TTL=30
MAX_OUTBOX_ROWS=10000
# Serialized queued payload budget, not a bound on the total SQLite file size.
MAX_OUTBOX_BYTES=33554432
# Completed command IDs are retained; reaching this limit blocks new commands.
MAX_COMMANDS=100000
