{
  "name": "bubblelock-web-dashboard",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.19.0"
  },
  "scripts": {
    "build:validators": "node scripts/build-validators.mjs",
    "check:validators": "node scripts/build-validators.mjs --check",
    "dev": "vite --host 127.0.0.1 --port 5173 --strictPort",
    "sse": "node server/cli.ts",
    "test": "node --test test/*.test.ts",
    "typecheck": "tsc --noEmit",
    "typecheck:contract": "tsc --noEmit -p tsconfig.contract.json",
    "build": "npm run check:validators && tsc --noEmit && vite build",
    "preview": "vite preview --host 127.0.0.1 --port 5173 --strictPort"
  },
  "dependencies": {
    "ajv": "^8.17.1",
    "ajv-formats": "^3.0.1",
    "leaflet": "^1.9.4",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@types/leaflet": "^1.9.21",
    "@types/node": "^24.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "esbuild": "0.28.2",
    "typescript": "~5.9.3",
    "vite": "^7.2.0"
  }
}
