# Map settings are public browser build-time values. Restart Vite or rebuild after changes.
# Empty values use OpenStreetMap without a provider key.
VITE_STADIA_MAPS_KEY=

# Optional domain authentication: first register this exact site hostname with Stadia.
# Hostname only, e.g. maps.example.test (no scheme, port, path or wildcard).
# A matching browser hostname enables Stadia without an API key.
VITE_STADIA_MAPS_DOMAIN=

# Optional XYZ tile source; takes precedence over Stadia key/domain for the default map.
# Local QA example: /offline-tiles/{z}/{x}/{y}.png
# The "street" map still uses OpenStreetMap; intercept external requests during QA.
VITE_MAP_TILE_URL=
VITE_MAP_ATTRIBUTION=
