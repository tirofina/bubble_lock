{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:privacy-bubble:keyring:0.1.0:ble-observation",
  "title": "BLE 원시 관측",
  "description": "KEYRING 후보 계약 0.1.0. PC-MOBIUS canonical contract 확정 및 실물 검증 전.",
  "type": "object",
  "properties": {
    "version": {
      "const": 1
    },
    "deviceId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
    },
    "bootId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
    },
    "sequence": {
      "type": "integer",
      "minimum": 0,
      "maximum": 4294967295
    },
    "uptimeMs": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "battery": {
      "anyOf": [
        {
          "type": "number",
          "minimum": 0,
          "maximum": 100
        },
        {
          "type": "null"
        }
      ]
    },
    "buttonState": {
      "type": "string",
      "enum": [
        "released",
        "confirm",
        "panic"
      ]
    },
    "sensorValues": {
      "type": "object",
      "maxProperties": 32,
      "propertyNames": {
        "minLength": 1,
        "maxLength": 64
      },
      "additionalProperties": {
        "type": [
          "number",
          "boolean",
          "string",
          "null",
          "object",
          "array"
        ]
      }
    },
    "state": {
      "type": "boolean"
    }
  },
  "required": [
    "version",
    "deviceId",
    "bootId",
    "sequence",
    "uptimeMs",
    "battery",
    "buttonState",
    "sensorValues",
    "state"
  ],
  "additionalProperties": false
}
