{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:privacy-bubble:keyring:0.1.0:receipt",
  "title": "Gateway → oneM2M 정산 receipt",
  "description": "KEYRING 후보 계약 0.1.0. PC-MOBIUS canonical contract 확정 및 실물 검증 전.",
  "type": "object",
  "properties": {
    "version": {
      "const": 1
    },
    "gatewayId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
    },
    "deviceId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
    },
    "commandId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
    },
    "payloadHash": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "status": {
      "type": "string",
      "enum": [
        "APPLIED",
        "REJECTED",
        "TIMEOUT",
        "INDETERMINATE"
      ]
    },
    "ackCode": {
      "type": "string",
      "pattern": "^[A-Z][A-Z0-9_]{0,63}$"
    },
    "acceptedAt": {
      "anyOf": [
        {
          "type": "string",
          "format": "date-time",
          "pattern": "(?:Z|[+-][0-9]{2}:[0-9]{2})$"
        },
        {
          "type": "null"
        }
      ]
    },
    "appliedAt": {
      "anyOf": [
        {
          "type": "string",
          "format": "date-time",
          "pattern": "(?:Z|[+-][0-9]{2}:[0-9]{2})$"
        },
        {
          "type": "null"
        }
      ]
    },
    "receivedAt": {
      "type": "string",
      "format": "date-time",
      "pattern": "(?:Z|[+-][0-9]{2}:[0-9]{2})$"
    },
    "readback": {
      "anyOf": [
        {
          "type": "object",
          "properties": {
            "state": {
              "type": "boolean"
            }
          },
          "required": [
            "state"
          ],
          "additionalProperties": false
        },
        {
          "type": "null"
        }
      ]
    },
    "firmwareRevision": {
      "anyOf": [
        {
          "type": "string",
          "minLength": 1,
          "maxLength": 64
        },
        {
          "type": "null"
        }
      ]
    },
    "ownershipEpoch": {
      "type": "integer",
      "minimum": 0,
      "maximum": 2147483647
    },
    "grantRevision": {
      "type": "integer",
      "minimum": 1,
      "maximum": 2147483647
    },
    "timestampSource": {
      "type": "string",
      "enum": [
        "gateway-estimated",
        "unavailable"
      ]
    },
    "detail": {
      "anyOf": [
        {
          "type": "string",
          "maxLength": 512
        },
        {
          "type": "null"
        }
      ]
    },
    "bootId": {
      "anyOf": [
        {
          "type": "string",
          "minLength": 1,
          "maxLength": 64,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
        },
        {
          "type": "null"
        }
      ]
    }
  },
  "required": [
    "version",
    "gatewayId",
    "deviceId",
    "commandId",
    "payloadHash",
    "status",
    "ackCode",
    "acceptedAt",
    "appliedAt",
    "receivedAt",
    "readback",
    "firmwareRevision",
    "ownershipEpoch",
    "grantRevision",
    "timestampSource",
    "detail",
    "bootId"
  ],
  "additionalProperties": false,
  "allOf": [
    {
      "if": {
        "properties": {
          "timestampSource": {
            "const": "unavailable"
          }
        },
        "required": [
          "timestampSource"
        ]
      },
      "then": {
        "properties": {
          "acceptedAt": {
            "type": "null"
          },
          "appliedAt": {
            "type": "null"
          }
        }
      }
    }
  ]
}
