{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:privacy-bubble:keyring:0.1.0:authorization",
  "title": "PC → Gateway dispatch 승인 응답",
  "description": "KEYRING 후보 계약 0.1.0. PC-MOBIUS canonical contract 확정 및 실물 검증 전.",
  "type": "object",
  "properties": {
    "allowed": {
      "type": "boolean"
    },
    "commandId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
    },
    "deviceId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
    },
    "claimId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
    },
    "payloadHash": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "grantRevision": {
      "type": "integer",
      "minimum": 1,
      "maximum": 2147483647
    },
    "ownershipEpoch": {
      "type": "integer",
      "minimum": 0,
      "maximum": 2147483647
    },
    "expiresAt": {
      "anyOf": [
        {
          "type": "string",
          "format": "date-time",
          "pattern": "(?:Z|[+-][0-9]{2}:[0-9]{2})$"
        },
        {
          "type": "null"
        }
      ]
    }
  },
  "required": [
    "allowed",
    "commandId",
    "deviceId",
    "claimId",
    "payloadHash",
    "grantRevision",
    "ownershipEpoch",
    "expiresAt"
  ],
  "additionalProperties": false,
  "allOf": [
    {
      "if": {
        "properties": {
          "allowed": {
            "const": true
          }
        },
        "required": [
          "allowed"
        ]
      },
      "then": {
        "properties": {
          "expiresAt": {
            "type": "string",
            "format": "date-time",
            "pattern": "(?:Z|[+-][0-9]{2}:[0-9]{2})$"
          }
        }
      }
    }
  ]
}
