{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:privacy-bubble:keyring:0.1.0:credential-status",
  "title": "PC → Gateway credential 상태",
  "description": "KEYRING 후보 계약 0.1.0. PC-MOBIUS canonical contract 확정 및 실물 검증 전.",
  "type": "object",
  "properties": {
    "gatewayId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
    },
    "credentialRevision": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64
    },
    "status": {
      "type": "string",
      "enum": [
        "ACTIVE",
        "LOST",
        "REVOKED"
      ]
    }
  },
  "required": [
    "gatewayId",
    "credentialRevision",
    "status"
  ],
  "additionalProperties": false
}
