{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:privacy-bubble:keyring:0.1.0:gateway-state-binding",
  "title": "KEYRING gateway-state-binding",
  "description": "Gateway 0.2.0 candidate. Local state provenance/consistency, not a central grant, attestation, restore activation or settlement receipt. Source implementation unverified.",
  "type": "object",
  "properties": {
    "bindingVersion": {
      "type": "integer",
      "enum": [1, 2, 3]
    },
    "gatewayId": {
      "type": "string",
      "minLength": 1
    },
    "originator": {
      "type": "string",
      "minLength": 1
    },
    "cseId": {
      "type": "string",
      "minLength": 1
    },
    "cseDeploymentId": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,63}$"
    },
    "pcApiDeploymentId": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,63}$"
    },
    "rvi": {
      "type": "string",
      "minLength": 1
    },
    "observationContainer": {
      "type": "string",
      "pattern": "^/"
    },
    "observationContainerRi": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,63}$"
    },
    "receiptContainer": {
      "type": "string",
      "pattern": "^/"
    },
    "receiptContainerRi": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,63}$"
    },
    "healthContainer": {
      "type": "string",
      "pattern": "^/"
    },
    "healthContainerRi": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,63}$"
    }
  },
  "required": [
    "bindingVersion",
    "gatewayId",
    "originator",
    "cseId",
    "rvi",
    "observationContainer",
    "receiptContainer",
    "healthContainer"
  ],
  "dependentRequired": {
    "receiptContainerRi": ["cseDeploymentId"], "observationContainerRi": ["cseDeploymentId"],
    "healthContainerRi": ["cseDeploymentId"]
  },
  "oneOf": [
    { "properties": { "bindingVersion": { "const": 1 } },
      "not": { "anyOf": [{ "required": ["cseDeploymentId"] }, { "required": ["pcApiDeploymentId"] }] } },
    { "properties": { "bindingVersion": { "const": 2 } }, "required": ["cseDeploymentId"],
      "not": { "required": ["pcApiDeploymentId"] } },
    { "properties": { "bindingVersion": { "const": 3 } }, "required": ["pcApiDeploymentId"] }
  ],
  "additionalProperties": false
}
