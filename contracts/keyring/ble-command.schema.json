{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:privacy-bubble:keyring:0.1.0:ble-command",
  "title": "Gateway → BLE 명령",
  "description": "KEYRING 후보 계약 0.1.0. PC-MOBIUS canonical contract 확정 및 실물 검증 전.",
  "type": "object",
  "properties": {
    "version": {
      "const": 1
    },
    "type": {
      "const": "command"
    },
    "deviceId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
    },
    "commandId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
    },
    "desiredState": {
      "type": "object",
      "properties": {
        "state": {
          "type": "boolean"
        }
      },
      "required": [
        "state"
      ],
      "additionalProperties": false
    },
    "grantRevision": {
      "type": "integer",
      "minimum": 1,
      "maximum": 2147483647
    },
    "ownershipEpoch": {
      "type": "integer",
      "minimum": 0,
      "maximum": 2147483647
    },
    "payloadHash": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "remainingMs": {
      "type": "integer",
      "minimum": 1,
      "maximum": 30000
    }
  },
  "required": [
    "version",
    "type",
    "deviceId",
    "commandId",
    "desiredState",
    "grantRevision",
    "ownershipEpoch",
    "payloadHash",
    "remainingMs"
  ],
  "additionalProperties": false
}
