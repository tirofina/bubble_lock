# Copy to deployment/.env. Local execution only; target laptop deployment needs approval.
COMPOSE_PROJECT_NAME=bubblelock-deploy
# Override with export RUN_TMP="$PWD/.local/deployment" from repository root.
RUN_TMP=/absolute/path/to/repository/.local/deployment
PUBLIC_DOMAIN=bubblelock.iptime.org
HTTP_PORT=80
HTTPS_PORT=443
MQTT_PORT=8883
BIND_ADDRESS=127.0.0.1
# Desktop QA uses HTTP_PORT=19080 HTTPS_PORT=19443 MQTT_PORT=19883.
# Target server uses BIND_ADDRESS=0.0.0.0 only after lead approval.
# Empty PUBLIC_DOMAIN selects bubble.localhost and local signed TLS.
KEYCLOAK_IMAGE=quay.io/keycloak/keycloak:26.5.2
POSTGRES_IMAGE=postgres:17.6-alpine
PROXY_IMAGE=nginx:1.28-alpine
NODE_IMAGE=node:22.22.0-bookworm-slim
MOSQUITTO_IMAGE=eclipse-mosquitto:2.0.22
ACME_EMAIL=
GATEWAY_ID=gateway-1
VITE_MAP_TILE_URL=
VITE_MAP_ATTRIBUTION=
VITE_STADIA_MAPS_KEY=
VITE_STADIA_MAPS_DOMAIN=
