{
  "contractId": "privacy-bubble.mcp-triage.v1",
  "docRevision": "2.0.0",
  "protocolVersion": "2025-11-25",
  "supportedProtocolVersions": [
    "2025-11-25",
    "2025-06-18"
  ],
  "schemaVersion": "https://json-schema.org/draft/2020-12/schema",
  "description": "Anomaly triage profile. A deterministic routine model writes alert contentInstances; the triage agent gathers situation-dependent context through the oneM2M, MEC and Audit servers and records a structured triage. The server derives run context from the authenticated session, keeps precise coordinates out of every tool output, and applies a location lease only with the guardian approvalHash bound to the exact draftHash.",
  "workflow": {
    "steps": [
      "readAlert",
      "submitTriage",
      "draftLocationLease",
      "requestGuardianApproval",
      "applyApprovedLease",
      "appendTriageEvidence"
    ],
    "leaseSteps": [
      "draftLocationLease",
      "requestGuardianApproval",
      "applyApprovedLease"
    ],
    "readOnlyTools": [
      "readAlert",
      "readRecentHistory",
      "readRoutineProfile",
      "readDeviceState",
      "queryUeLocation",
      "queryZoneStatus",
      "queryServingCell",
      "readExecution"
    ],
    "readBudget": 14,
    "actions": {
      "observe": "no guardian notification; the routine model keeps watching",
      "checkIn": "guardian notification to call or check on the resident",
      "emergencyLease": "urgent guardian notification and a guardian-approved precise location lease of at most maxLeaseMinutes"
    },
    "leasePurposes": [
      "wandering-check",
      "emergency-rescue"
    ],
    "maxLeaseMinutes": 5,
    "actionOrder": [
      "observe",
      "checkIn",
      "emergencyLease"
    ],
    "actionFloor": {
      "WANDERING": {
        "minimumAction": "checkIn",
        "reason": "the routine model found a behavioural deviation; the guardian is told every time and the agent chooses checkIn or emergencyLease and the wording"
      },
      "DEVICE_SEPARATION": {
        "minimumAction": "checkIn",
        "reason": "the resident is out without the PANIC button; the guardian is told every time (product rule, not an agent judgement)"
      }
    },
    "approvalGate": {
      "tool": "applyApprovedLease",
      "requires": "guardian approvalHash for the exact current draftHash",
      "approver": "guardian principal outside the MCP agent session"
    },
    "states": [
      "READY",
      "TRIAGING",
      "TRIAGED",
      "DRAFTED",
      "AWAITING_GUARDIAN",
      "APPROVED",
      "DRAFT_REJECTED",
      "LEASE_APPLIED",
      "COMPLETED"
    ]
  },
  "servers": {
    "oneM2M": {
      "audience": "privacy-bubble-mcp-onem2m",
      "tools": [
        {
          "name": "readAlert",
          "description": "Read the routine-model alert that woke the triage agent from the resident alerts container on the oneM2M CSE: alert kind, score, feature values, map segment (name only) and local times. Required first step.",
          "requiredScope": "bubble:read",
          "readOnly": true,
          "inputSchema": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "alertId"
            ],
            "properties": {
              "alertId": {
                "type": "string",
                "minLength": 1,
                "maxLength": 96,
                "pattern": "^[A-Za-z0-9._:-]+$"
              }
            }
          },
          "outputSchema": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "alertId",
              "kind",
              "score",
              "severityHint",
              "detectedLocal",
              "startedLocal",
              "nowLocal",
              "segment",
              "features",
              "modelVersion",
              "profileHash",
              "alertRecordPath",
              "minimumAction"
            ],
            "properties": {
              "alertId": {
                "type": "string",
                "minLength": 1,
                "maxLength": 96,
                "pattern": "^[A-Za-z0-9._:-]+$"
              },
              "kind": {
                "enum": [
                  "WANDERING",
                  "SIGNAL_GAP",
                  "DEVICE_SEPARATION"
                ]
              },
              "score": {
                "type": "number"
              },
              "severityHint": {
                "enum": [
                  "check",
                  "watch",
                  "urgent"
                ]
              },
              "detectedLocal": {
                "type": "string",
                "pattern": "^[0-2][0-9]:[0-5][0-9](:[0-5][0-9])?$"
              },
              "startedLocal": {
                "type": "string",
                "pattern": "^[0-2][0-9]:[0-5][0-9](:[0-5][0-9])?$"
              },
              "nowLocal": {
                "type": "string",
                "pattern": "^[0-2][0-9]:[0-5][0-9](:[0-5][0-9])?$"
              },
              "segment": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "name",
                  "kind"
                ],
                "properties": {
                  "name": {
                    "type": "string",
                    "maxLength": 64
                  },
                  "kind": {
                    "type": "string",
                    "maxLength": 16
                  }
                }
              },
              "features": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "dwellSec",
                  "dwellRefSec",
                  "dwellRatio",
                  "reversals",
                  "distanceHomeM",
                  "gapSec",
                  "components"
                ],
                "properties": {
                  "dwellSec": {
                    "type": "number"
                  },
                  "dwellRefSec": {
                    "type": "number"
                  },
                  "dwellRatio": {
                    "type": "number"
                  },
                  "reversals": {
                    "type": "integer",
                    "minimum": 0
                  },
                  "speedMps": {
                    "type": "number"
                  },
                  "corridorDistanceM": {
                    "type": "number"
                  },
                  "offCorridorSec": {
                    "type": "number"
                  },
                  "offCorridorSince": {
                    "type": "string",
                    "pattern": "^[0-2][0-9]:[0-5][0-9](:[0-5][0-9])?$"
                  },
                  "stopSince": {
                    "type": "string",
                    "pattern": "^[0-2][0-9]:[0-5][0-9](:[0-5][0-9])?$"
                  },
                  "minutesAfterSunset": {
                    "type": "number"
                  },
                  "sunsetLocal": {
                    "type": "string",
                    "pattern": "^[0-2][0-9]:[0-5][0-9](:[0-5][0-9])?$"
                  },
                  "minutesPastUsualReturn": {
                    "type": "number"
                  },
                  "distanceHomeM": {
                    "type": "number"
                  },
                  "gapSec": {
                    "type": "number"
                  },
                  "gapRefSec": {
                    "type": "number"
                  },
                  "lastSampleAt": {
                    "type": "string",
                    "pattern": "^[0-2][0-9]:[0-5][0-9](:[0-5][0-9])?$"
                  },
                  "components": {
                    "type": "object",
                    "additionalProperties": false,
                    "required": [
                      "dwell",
                      "pacing",
                      "offCorridor",
                      "dusk",
                      "distance"
                    ],
                    "properties": {
                      "dwell": {
                        "type": "number"
                      },
                      "pacing": {
                        "type": "number"
                      },
                      "offCorridor": {
                        "type": "number"
                      },
                      "dusk": {
                        "type": "number"
                      },
                      "distance": {
                        "type": "number"
                      }
                    }
                  },
                  "keyring": {
                    "type": "object",
                    "additionalProperties": false,
                    "required": [
                      "bleSeenBy",
                      "battery",
                      "seenAt"
                    ],
                    "properties": {
                      "bleSeenBy": {
                        "type": "string",
                        "maxLength": 24
                      },
                      "battery": {
                        "type": "number"
                      },
                      "seenAt": {
                        "type": "string",
                        "pattern": "^[0-2][0-9]:[0-5][0-9](:[0-5][0-9])?$"
                      }
                    }
                  }
                }
              },
              "modelVersion": {
                "type": "string",
                "maxLength": 64
              },
              "profileHash": {
                "type": "string",
                "pattern": "^[a-f0-9]{64}$"
              },
              "alertRecordPath": {
                "type": "string",
                "maxLength": 256
              },
              "minimumAction": {
                "enum": [
                  "observe",
                  "checkIn",
                  "emergencyLease"
                ]
              },
              "minimumActionReason": {
                "type": "string",
                "maxLength": 160
              }
            }
          }
        },
        {
          "name": "readRecentHistory",
          "description": "Summarize the resident location contentInstances of the last N minutes from the oneM2M CSE as map segments with times, usual-corridor flags, sample gaps and the last few 3-decimal grid cells (about 110 m), plus stop episodes (stayed within 35 m for at least a minute, with direction reversals). At a junction the segment name can change while she stands still; stops show where she actually stayed. Precise coordinates are never returned.",
          "requiredScope": "bubble:read",
          "readOnly": true,
          "inputSchema": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "minutes"
            ],
            "properties": {
              "minutes": {
                "type": "integer",
                "minimum": 5,
                "maximum": 60
              }
            }
          },
          "outputSchema": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "fromLocal",
              "toLocal",
              "samples",
              "segments",
              "stops",
              "gaps",
              "recentGrid",
              "precision"
            ],
            "properties": {
              "fromLocal": {
                "type": "string",
                "pattern": "^[0-2][0-9]:[0-5][0-9](:[0-5][0-9])?$"
              },
              "toLocal": {
                "type": "string",
                "pattern": "^[0-2][0-9]:[0-5][0-9](:[0-5][0-9])?$"
              },
              "samples": {
                "type": "integer",
                "minimum": 0
              },
              "segments": {
                "type": "array",
                "maxItems": 24,
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "segment",
                    "kind",
                    "fromLocal",
                    "toLocal",
                    "minutes",
                    "onCorridor",
                    "samples"
                  ],
                  "properties": {
                    "segment": {
                      "type": "string",
                      "maxLength": 64
                    },
                    "kind": {
                      "type": "string",
                      "maxLength": 16
                    },
                    "fromLocal": {
                      "type": "string",
                      "pattern": "^[0-2][0-9]:[0-5][0-9](:[0-5][0-9])?$"
                    },
                    "toLocal": {
                      "type": "string",
                      "pattern": "^[0-2][0-9]:[0-5][0-9](:[0-5][0-9])?$"
                    },
                    "minutes": {
                      "type": "number"
                    },
                    "onCorridor": {
                      "type": "boolean"
                    },
                    "samples": {
                      "type": "integer",
                      "minimum": 0
                    }
                  }
                }
              },
              "stops": {
                "type": "array",
                "maxItems": 12,
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "place",
                    "fromLocal",
                    "toLocal",
                    "minutes",
                    "reversals",
                    "withinM"
                  ],
                  "properties": {
                    "place": {
                      "type": "string",
                      "maxLength": 64
                    },
                    "fromLocal": {
                      "type": "string",
                      "pattern": "^[0-2][0-9]:[0-5][0-9](:[0-5][0-9])?$"
                    },
                    "toLocal": {
                      "type": "string",
                      "pattern": "^[0-2][0-9]:[0-5][0-9](:[0-5][0-9])?$"
                    },
                    "minutes": {
                      "type": "number"
                    },
                    "reversals": {
                      "type": "integer",
                      "minimum": 0
                    },
                    "withinM": {
                      "type": "number"
                    }
                  }
                }
              },
              "gaps": {
                "type": "array",
                "maxItems": 12,
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "fromLocal",
                    "toLocal",
                    "seconds"
                  ],
                  "properties": {
                    "fromLocal": {
                      "type": "string",
                      "pattern": "^[0-2][0-9]:[0-5][0-9](:[0-5][0-9])?$"
                    },
                    "toLocal": {
                      "type": "string",
                      "pattern": "^[0-2][0-9]:[0-5][0-9](:[0-5][0-9])?$"
                    },
                    "seconds": {
                      "type": "number"
                    }
                  }
                }
              },
              "recentGrid": {
                "type": "array",
                "maxItems": 6,
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "localTime",
                    "lat",
                    "lon"
                  ],
                  "properties": {
                    "localTime": {
                      "type": "string",
                      "pattern": "^[0-2][0-9]:[0-5][0-9](:[0-5][0-9])?$"
                    },
                    "lat": {
                      "type": "number"
                    },
                    "lon": {
                      "type": "number"
                    }
                  }
                }
              },
              "precision": {
                "const": "grid-3-decimals"
              }
            }
          }
        },
        {
          "name": "readRoutineProfile",
          "description": "Read the resident routine profile (learned from her oneM2M location history of normal walk days): usual departure and return times, usual corridor segments, usual stops with dwell percentiles, usual signal gaps, walking speed and today's sunset.",
          "requiredScope": "bubble:read",
          "readOnly": true,
          "inputSchema": {
            "type": "object",
            "additionalProperties": false,
            "required": [],
            "properties": {}
          },
          "outputSchema": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "modelVersion",
              "days",
              "synthetic",
              "profileHash",
              "usualDeparture",
              "usualReturn",
              "latestUsualReturn",
              "sunsetLocal",
              "walkingSpeedMps",
              "corridor",
              "usualStops",
              "usualSignalGaps"
            ],
            "properties": {
              "modelVersion": {
                "type": "string",
                "maxLength": 64
              },
              "days": {
                "type": "integer",
                "minimum": 0
              },
              "synthetic": {
                "type": "boolean"
              },
              "profileHash": {
                "type": "string",
                "pattern": "^[a-f0-9]{64}$"
              },
              "usualDeparture": {
                "type": "string",
                "pattern": "^[0-2][0-9]:[0-5][0-9](:[0-5][0-9])?$"
              },
              "usualReturn": {
                "type": "string",
                "pattern": "^[0-2][0-9]:[0-5][0-9](:[0-5][0-9])?$"
              },
              "latestUsualReturn": {
                "type": "string",
                "pattern": "^[0-2][0-9]:[0-5][0-9](:[0-5][0-9])?$"
              },
              "sunsetLocal": {
                "type": "string",
                "pattern": "^[0-2][0-9]:[0-5][0-9](:[0-5][0-9])?$"
              },
              "walkingSpeedMps": {
                "type": "number"
              },
              "corridor": {
                "type": "array",
                "maxItems": 48,
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "segment",
                    "kind",
                    "days"
                  ],
                  "properties": {
                    "segment": {
                      "type": "string",
                      "maxLength": 64
                    },
                    "kind": {
                      "type": "string",
                      "maxLength": 16
                    },
                    "days": {
                      "type": "integer",
                      "minimum": 0
                    }
                  }
                }
              },
              "usualStops": {
                "type": "array",
                "maxItems": 16,
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "segment",
                    "p50Sec",
                    "p95Sec",
                    "days"
                  ],
                  "properties": {
                    "segment": {
                      "type": "string",
                      "maxLength": 64
                    },
                    "p50Sec": {
                      "type": "number"
                    },
                    "p95Sec": {
                      "type": "number"
                    },
                    "days": {
                      "type": "integer",
                      "minimum": 0
                    }
                  }
                }
              },
              "usualSignalGaps": {
                "type": "array",
                "maxItems": 16,
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "segment",
                    "p95Sec",
                    "days"
                  ],
                  "properties": {
                    "segment": {
                      "type": "string",
                      "maxLength": 64
                    },
                    "p95Sec": {
                      "type": "number"
                    },
                    "days": {
                      "type": "integer",
                      "minimum": 0
                    }
                  }
                }
              }
            }
          }
        },
        {
          "name": "readDeviceState",
          "description": "Read the keyring device state from the oneM2M CSE: battery, which receiver last saw the keyring over BLE (relay-ue carried by the resident, home-gateway, none), button state and the last PANIC event.",
          "requiredScope": "bubble:read",
          "readOnly": true,
          "inputSchema": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "deviceId"
            ],
            "properties": {
              "deviceId": {
                "type": "string",
                "minLength": 1,
                "maxLength": 96,
                "pattern": "^[A-Za-z0-9._:-]+$"
              }
            }
          },
          "outputSchema": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "deviceId",
              "battery",
              "bleSeenBy",
              "bleLastSeenLocal",
              "button",
              "stateRecordPath"
            ],
            "properties": {
              "deviceId": {
                "type": "string",
                "minLength": 1,
                "maxLength": 96,
                "pattern": "^[A-Za-z0-9._:-]+$"
              },
              "battery": {
                "type": "number"
              },
              "bleSeenBy": {
                "enum": [
                  "relay-ue",
                  "home-gateway",
                  "none"
                ]
              },
              "bleLastSeenLocal": {
                "type": "string",
                "pattern": "^[0-2][0-9]:[0-5][0-9](:[0-5][0-9])?$"
              },
              "button": {
                "type": "string",
                "maxLength": 16
              },
              "lastPanicLocal": {
                "type": "string",
                "maxLength": 8
              },
              "stateRecordPath": {
                "type": "string",
                "maxLength": 256
              }
            }
          }
        },
        {
          "name": "submitTriage",
          "description": "Record the structured triage for the alert. action observe = keep watching, no guardian notification; checkIn = notify the guardian to call or check on the resident; emergencyLease = urgent, notify the guardian and continue with draftLocationLease. The guardian-facing explanation must use times and place names, never coordinates. readAlert reports the minimumAction for the alert kind; a lower action returns ACTION_FLOOR.",
          "requiredScope": "bubble:command",
          "readOnly": false,
          "inputSchema": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "alertId",
              "severity",
              "action",
              "explanation",
              "checked"
            ],
            "properties": {
              "alertId": {
                "type": "string",
                "minLength": 1,
                "maxLength": 96,
                "pattern": "^[A-Za-z0-9._:-]+$"
              },
              "severity": {
                "enum": [
                  "info",
                  "watch",
                  "urgent"
                ]
              },
              "action": {
                "enum": [
                  "observe",
                  "checkIn",
                  "emergencyLease"
                ]
              },
              "explanation": {
                "type": "string",
                "minLength": 20,
                "maxLength": 280
              },
              "checked": {
                "type": "array",
                "maxItems": 16,
                "uniqueItems": true,
                "items": {
                  "type": "string",
                  "maxLength": 48
                }
              },
              "recheckMinutes": {
                "type": "integer",
                "minimum": 1,
                "maximum": 30
              }
            }
          },
          "outputSchema": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "triageId",
              "alertId",
              "severity",
              "action",
              "guardianNotified",
              "triageRecordPath",
              "nextStep"
            ],
            "properties": {
              "triageId": {
                "type": "string",
                "minLength": 1,
                "maxLength": 96,
                "pattern": "^[A-Za-z0-9._:-]+$"
              },
              "alertId": {
                "type": "string",
                "minLength": 1,
                "maxLength": 96,
                "pattern": "^[A-Za-z0-9._:-]+$"
              },
              "severity": {
                "type": "string",
                "maxLength": 16
              },
              "action": {
                "type": "string",
                "maxLength": 16
              },
              "guardianNotified": {
                "type": "boolean"
              },
              "incidentId": {
                "type": "string",
                "minLength": 1,
                "maxLength": 96,
                "pattern": "^[A-Za-z0-9._:-]+$"
              },
              "triageRecordPath": {
                "type": "string",
                "maxLength": 256
              },
              "inboxRecordPath": {
                "type": "string",
                "maxLength": 256
              },
              "nextStep": {
                "type": "string",
                "maxLength": 48
              }
            }
          }
        },
        {
          "name": "draftLocationLease",
          "description": "Draft a short emergency location lease that lets the recipient open the resident precise location. The server stores the draft with a draftHash and least-privilege findings; nothing is shared until the guardian approves this exact draftHash.",
          "requiredScope": "bubble:command",
          "readOnly": false,
          "inputSchema": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "recipientId",
              "purpose",
              "durationMinutes",
              "deviceId"
            ],
            "properties": {
              "recipientId": {
                "type": "string",
                "minLength": 1,
                "maxLength": 96,
                "pattern": "^[A-Za-z0-9._:-]+$"
              },
              "purpose": {
                "enum": [
                  "wandering-check",
                  "emergency-rescue"
                ]
              },
              "durationMinutes": {
                "type": "integer",
                "minimum": 1,
                "maximum": 60
              },
              "deviceId": {
                "type": "string",
                "minLength": 1,
                "maxLength": 96,
                "pattern": "^[A-Za-z0-9._:-]+$"
              }
            }
          },
          "outputSchema": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "draftId",
              "draftHash",
              "recipientId",
              "purpose",
              "durationMinutes",
              "deviceId",
              "leastPrivilege",
              "status"
            ],
            "properties": {
              "draftId": {
                "type": "string",
                "minLength": 1,
                "maxLength": 96,
                "pattern": "^[A-Za-z0-9._:-]+$"
              },
              "draftHash": {
                "type": "string",
                "pattern": "^[a-f0-9]{64}$"
              },
              "recipientId": {
                "type": "string",
                "minLength": 1,
                "maxLength": 96,
                "pattern": "^[A-Za-z0-9._:-]+$"
              },
              "purpose": {
                "type": "string",
                "maxLength": 32
              },
              "durationMinutes": {
                "type": "integer",
                "minimum": 1,
                "maximum": 60
              },
              "deviceId": {
                "type": "string",
                "minLength": 1,
                "maxLength": 96,
                "pattern": "^[A-Za-z0-9._:-]+$"
              },
              "leastPrivilege": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "withinTask",
                  "findings"
                ],
                "properties": {
                  "withinTask": {
                    "type": "boolean"
                  },
