              },
              "onCorridor": {
                "type": "boolean"
              },
              "distanceHomeM": {
                "type": "number"
              },
              "movedSinceLastFixM": {
                "type": "number"
              },
              "lastFixLocal": {
                "type": "string",
                "pattern": "^[0-2][0-9]:[0-5][0-9](:[0-5][0-9])?$"
              },
              "observedLocal": {
                "type": "string",
                "pattern": "^[0-2][0-9]:[0-5][0-9](:[0-5][0-9])?$"
              }
            }
          }
        },
        {
          "name": "queryZoneStatus",
          "description": "Query the ETSI MEC013 v3 Location zone status (queries/zones/{zoneId}): access points, unserviceable access points and users in the zone.",
          "requiredScope": "mec:location",
          "readOnly": true,
          "inputSchema": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "zoneId"
            ],
            "properties": {
              "zoneId": {
                "type": "string",
                "minLength": 1,
                "maxLength": 64,
                "pattern": "^[A-Za-z0-9._-]+$"
              }
            }
          },
          "outputSchema": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "source",
              "zoneId",
              "numberOfAccessPoints",
              "numberOfUnserviceableAccessPoints",
              "numberOfUsers"
            ],
            "properties": {
              "source": {
                "type": "string",
                "maxLength": 64
              },
              "zoneId": {
                "type": "string",
                "maxLength": 64
              },
              "numberOfAccessPoints": {
                "type": "integer",
                "minimum": 0
              },
              "numberOfUnserviceableAccessPoints": {
                "type": "integer",
                "minimum": 0
