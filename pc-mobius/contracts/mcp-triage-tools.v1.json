    "MEC": {
      "audience": "privacy-bubble-mcp-mec",
      "tools": [
        {
          "name": "queryUeLocation",
          "description": "Query the ETSI MEC013 v3 Location service (queries/users) for the resident relay UE now: zone, access point, 3-decimal grid cell, map segment, whether it is on the usual corridor, distance from home and distance moved since the last stored location fix.",
          "requiredScope": "mec:location",
          "readOnly": true,
          "inputSchema": {
            "type": "object",
            "additionalProperties": false,
            "required": [],
            "properties": {}
          },
          "outputSchema": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "source",
              "zoneId",
              "accessPointId",
              "grid",
              "segment",
              "onCorridor",
              "distanceHomeM",
              "movedSinceLastFixM",
              "lastFixLocal",
              "observedLocal"
            ],
            "properties": {
              "source": {
                "type": "string",
                "maxLength": 64
              },
              "zoneId": {
                "type": "string",
                "maxLength": 64
              },
              "accessPointId": {
                "type": "string",
                "maxLength": 64
              },
              "grid": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "lat",
                  "lon",
                  "decimals"
                ],
                "properties": {
                  "lat": {
                    "type": "number"
                  },
                  "lon": {
                    "type": "number"
                  },
                  "decimals": {
                    "const": 3
                  }
                }
              },
              "segment": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "name",
                  "kind"
                ],
                "properties": {
                  "name": {
                    "type": "string",
                    "maxLength": 64
                  },
                  "kind": {
                    "type": "string",
                    "maxLength": 16
                  }
