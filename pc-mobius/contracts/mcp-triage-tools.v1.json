                    "fromCell",
                    "toCell"
                  ],
                  "properties": {
                    "localTime": {
                      "type": "string",
                      "pattern": "^[0-2][0-9]:[0-5][0-9](:[0-5][0-9])?$"
                    },
                    "fromCell": {
                      "type": "string",
                      "maxLength": 32
                    },
