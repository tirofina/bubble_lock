                "type": "string",
                "maxLength": 32
              },
              "observedLocal": {
                "type": "string",
                "pattern": "^[0-2][0-9]:[0-5][0-9](:[0-5][0-9])?$"
              },
              "cellChangesInWindow": {
                "type": "integer",
                "minimum": 0
